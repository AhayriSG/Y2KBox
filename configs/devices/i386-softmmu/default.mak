# Default configuration for i386-softmmu -- XP fork.
#
# Target: Windows XP (32-bit) guests on the i440fx "pc" machine.
# Everything not explicitly enabled below is switched off because XP cannot use it,
# or it only exists for other guests (modern PCIe machines, confidential computing,
# paravirtual Xen/KVM-only bits, UEFI). A narrow VirtIO Block/Net subset is enabled
# separately for optional XP driver evaluation (T15).

CONFIG_Q35=n
CONFIG_MICROVM=n
CONFIG_NITRO_ENCLAVE=n
CONFIG_ISAPC=n
CONFIG_SEV=n
CONFIG_SGX=n
CONFIG_TDX=n
CONFIG_X86_FW_OVMF=n

# ---- XP device set --------------------------------------------------------
# Kept: PC/i440FX platform, PIIX IDE, floppy, PS/2, serial/parallel, VGA +
# Cirrus (in-box XP driver), RTL8139/PCnet/e1000 NICs, AC97/ES1370/SB16 audio,
# USB UHCI/OHCI/EHCI + HID + mass storage. VirtIO Block/Net are also enabled as
# optional owner-tested devices; unrelated VirtIO devices remain off.

# Optional paravirtual devices for owner-tested XP drivers (T15).
# VirtIO implementation sources are currently pruned from this fork; keep off
# until T15 restores the required core, PCI, block, and network source files.
CONFIG_VIRTIO=n
CONFIG_VIRTIO_PCI=n
CONFIG_VIRTIO_9P=n
CONFIG_VIRTIO_BALLOON=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_CRYPTO=n
CONFIG_VIRTIO_GPU=n
CONFIG_VIRTIO_INPUT=n
CONFIG_VIRTIO_INPUT_HOST=n
CONFIG_VIRTIO_IOMMU=n
CONFIG_VIRTIO_MEM=n
CONFIG_VIRTIO_PMEM=n
CONFIG_VIRTIO_RNG=n
CONFIG_VIRTIO_RTC=n
CONFIG_VIRTIO_SCSI=n
CONFIG_VIRTIO_SERIAL=n
CONFIG_VIRTIO_SND=n
CONFIG_VIRTIO_VGA=n
CONFIG_VHOST_USER_BLK=n
CONFIG_VHOST_USER_FS=n
CONFIG_VHOST_USER_GPIO=n
CONFIG_VHOST_USER_GPU=n
CONFIG_VHOST_USER_I2C=n
CONFIG_VHOST_USER_INPUT=n
CONFIG_VHOST_USER_MEDIA=n
CONFIG_VHOST_USER_RNG=n
CONFIG_VHOST_USER_RTC=n
CONFIG_VHOST_USER_SCSI=n
CONFIG_VHOST_USER_SND=n
CONFIG_VHOST_USER_SPI=n
CONFIG_VHOST_USER_TEST=n
CONFIG_VHOST_USER_VGA=n
CONFIG_VHOST_USER_VSOCK=n
CONFIG_VHOST_VDPA_DEV=n
CONFIG_VHOST_VSOCK=n
CONFIG_VHOST_SCSI=n
CONFIG_FSDEV_9P=n

# memory hotplug / NVDIMM / CXL / table builders removed with the fixed machine (T01)
CONFIG_DIMM=n
CONFIG_MEM_DEVICE=n
CONFIG_NVDIMM=n
CONFIG_ACPI_NVDIMM=n
CONFIG_ACPI_HMAT=n
CONFIG_ACPI_VIOT=n
CONFIG_ACPI_CXL=n
CONFIG_ACPI_VMGENID=n
CONFIG_ACPI_VMCLOCK=n
CONFIG_ACPI_MEMORY_HOTPLUG=n
CONFIG_HV_BALLOON_SUPPORTED=n
# passthrough / IOMMU
CONFIG_VFIO=n
CONFIG_VFIO_PCI=n
CONFIG_VFIO_IGD=n
CONFIG_VFIO_USER=n
CONFIG_IOMMU_TESTDEV=n
CONFIG_SPDM_SOCKET=n

# storage controllers XP has no driver for (IDE/floppy stay)
CONFIG_AHCI=n
CONFIG_AHCI_ICH9=n
CONFIG_NVME_PCI=n
CONFIG_UFS=n
CONFIG_UFS_PCI=n
CONFIG_MEGASAS_SCSI_PCI=n
CONFIG_MPTSAS_SCSI_PCI=n
CONFIG_VMW_PVSCSI_SCSI_PCI=n
CONFIG_LSI_SCSI_PCI=n
CONFIG_ESP=n
CONFIG_ESP_PCI=n
CONFIG_SD=n
CONFIG_SDHCI=n
CONFIG_SDHCI_PCI=n
CONFIG_IPACK=n
CONFIG_TPCI200=n
CONFIG_IP_OCTAL_232=n

# NICs: keep RTL8139, PCnet, e1000
CONFIG_EEPRO100_PCI=n
CONFIG_NE2000_PCI=n
CONFIG_NE2000_ISA=n
CONFIG_TULIP=n
CONFIG_VMXNET3_PCI=n
CONFIG_ROCKER=n
CONFIG_CAN_BUS=n
CONFIG_CAN_CTUCANFD=n
CONFIG_CAN_CTUCANFD_PCI=n
CONFIG_CAN_PCI=n
CONFIG_CAN_SJA1000=n

# audio: keep AC97, ES1370, SB16
CONFIG_ADLIB=n
CONFIG_GUS=n
CONFIG_CS4231A=n
CONFIG_HDA=n
CONFIG_USB_AUDIO=n

# display: VMVGA (VMware SVGA II + SVGA3D) is the default and only display device
CONFIG_VGA_CIRRUS=n
CONFIG_VGA_PCI=n
CONFIG_VMWARE_VGA=y
CONFIG_ATI_VGA=n
CONFIG_BOCHS_DISPLAY=n
CONFIG_VMMOUSE=y
CONFIG_VMPORT=y

# USB: UHCI/OHCI/EHCI + hub + HID + storage only
CONFIG_USB_XHCI=n
CONFIG_USB_XHCI_NEC=n
CONFIG_USB_XHCI_PCI=n
CONFIG_USB_CANOKEY=n
CONFIG_USB_SMARTCARD=n
CONFIG_USB_U2F=n
CONFIG_USB_SERIAL=n
CONFIG_USB_NETWORK=n
CONFIG_USB_TABLET_WACOM=n
CONFIG_USB_STORAGE_MTP=n
CONFIG_USB_STORAGE_UAS=n

# misc
CONFIG_IPMI=n
CONFIG_IPMI_EXTERN=n
CONFIG_IPMI_LOCAL=n
CONFIG_IPMI_SSIF=n
CONFIG_ISA_IPMI_BT=n
CONFIG_ISA_IPMI_KCS=n
CONFIG_PCI_IPMI_BT=n
CONFIG_PCI_IPMI_KCS=n
CONFIG_TPM_BACKEND=n
CONFIG_TPM_CRB=n
CONFIG_TPM_EMULATOR=n
CONFIG_TPM_PASSTHROUGH=n
CONFIG_TPM_TIS=n
CONFIG_TPM_TIS_ISA=n
CONFIG_IVSHMEM_DEVICE=n
CONFIG_IVSHMEM_FLAT_DEVICE=n
CONFIG_PVPANIC_COMMON=n
CONFIG_PVPANIC_ISA=n
CONFIG_PVPANIC_PCI=n
CONFIG_WDT_IB6300ESB=n
CONFIG_WDT_IB700=n
CONFIG_APPLESMC=n
CONFIG_EDU=n
CONFIG_TEST_DEVICES=n
CONFIG_PCI_TESTDEV=n
CONFIG_ISA_TESTDEV=n
CONFIG_I2C_ECHO=n
CONFIG_GENERIC_LOADER=n
