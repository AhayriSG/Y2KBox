i2c_ss = ss.source_set()
i2c_ss.add(when: 'CONFIG_I2C', if_true: files('core.c'))
i2c_ss.add(when: 'CONFIG_SMBUS', if_true: files('smbus_slave.c', 'smbus_master.c'))
i2c_ss.add(when: 'CONFIG_ACPI_SMBUS', if_true: files('pm_smbus.c'))
i2c_ss.add(when: 'CONFIG_ACPI_ICH9', if_true: files())
i2c_ss.add(when: 'CONFIG_ASPEED_SOC', if_true: files())
i2c_ss.add(when: 'CONFIG_BITBANG_I2C', if_true: files())
i2c_ss.add(when: 'CONFIG_EXYNOS4', if_true: files())
i2c_ss.add(when: 'CONFIG_IMX_I2C', if_true: files())
i2c_ss.add(when: 'CONFIG_MPC_I2C', if_true: files())
i2c_ss.add(when: 'CONFIG_ALLWINNER_I2C', if_true: files())
i2c_ss.add(when: 'CONFIG_NRF51_SOC', if_true: files())
i2c_ss.add(when: 'CONFIG_NPCM7XX', if_true: files())
i2c_ss.add(when: 'CONFIG_DESIGNWARE_I2C', if_true: files())
i2c_ss.add(when: 'CONFIG_SMBUS_EEPROM', if_true: files('smbus_eeprom.c'))
i2c_ss.add(when: 'CONFIG_ARM_SBCON_I2C', if_true: files())
i2c_ss.add(when: 'CONFIG_OMAP', if_true: files())
i2c_ss.add(when: 'CONFIG_PPC4XX', if_true: files())
i2c_ss.add(when: 'CONFIG_PCA954X', if_true: files())
i2c_ss.add(when: 'CONFIG_PMBUS', if_true: files())
i2c_ss.add(when: 'CONFIG_BCM2835_I2C', if_true: files())
system_ss.add_all(when: 'CONFIG_I2C', if_true: i2c_ss)
