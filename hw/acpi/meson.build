acpi_ss = ss.source_set()
acpi_ss.add(files(
  'aml-build.c',
  'bios-linker-loader.c',
  'core.c',
  'utils.c',
))
acpi_ss.add(when: 'CONFIG_ACPI_CPU_HOTPLUG', if_true: files('cpu.c'))
stub_ss.add(files('acpi-cpu-hotplug-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_MEMORY_HOTPLUG', if_true: files())
stub_ss.add(files('acpi-mem-hotplug-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_NVDIMM', if_true: files())
stub_ss.add(files('acpi-nvdimm-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_PCI', if_true: files('pci.c'))
acpi_ss.add(when: 'CONFIG_ACPI_CXL', if_true: files())
stub_ss.add(files('cxl-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_VMGENID', if_true: files())
acpi_ss.add(when: 'CONFIG_ACPI_VMCLOCK', if_true: files())
acpi_ss.add(when: 'CONFIG_ACPI_HW_REDUCED', if_true: files())
acpi_ss.add(when: 'CONFIG_ACPI_HMAT', if_true: files())
acpi_ss.add(when: 'CONFIG_ACPI_APEI', if_true: files())
stub_ss.add(files('ghes-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_PIIX4', if_true: files('piix4.c'))
acpi_ss.add(when: 'CONFIG_ACPI_PCI_BRIDGE', if_true: files('pci-bridge.c'))
acpi_ss.add(when: 'CONFIG_ACPI_PCIHP', if_true: files('pcihp.c'))
stub_ss.add(files('acpi-pci-hotplug-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_VIOT', if_true: files())
acpi_ss.add(when: 'CONFIG_ACPI_ICH9', if_true: files())
stub_ss.add(files('wdat-ich9-stub.c'))
acpi_ss.add(when: 'CONFIG_ACPI_ERST', if_true: files('erst.c'))
acpi_ss.add(when: 'CONFIG_IPMI', if_true: files())
stub_ss.add(files('ipmi-stub.c'))
stub_ss.add(files('acpi-x86-stub.c'))
acpi_ss.add(when: 'CONFIG_WDT_SBSA', if_true: files())
if have_tpm
  acpi_ss.add(files('tpm.c'))
endif
stub_ss.add(files('acpi-stub.c', 'aml-build-stub.c', 'ghes-stub.c'))
stub_ss.add(files('pci-bridge-stub.c'))
stub_ss.add(files('wdat-gwdt-stub.c'))
system_ss.add_all(when: 'CONFIG_ACPI', if_true: acpi_ss)
system_ss.add(when: 'CONFIG_GHES_CPER', if_true: files())
stub_ss.add(files('ghes_cper_stub.c'))
system_ss.add(files('acpi-qmp-cmds.c', 'acpi_interface.c'))
